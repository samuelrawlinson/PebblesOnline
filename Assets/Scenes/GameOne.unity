  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "On your turn, select a card using numbers 1-3, and Esc to deselect. \nWhen
    you hit the R key to Ready, you and your foe will play your chosen cards.\n\n<b>Hills</b>
    let you draw a card, and <b>Valleys</b> make your foe discard, \nand the first
    person to run out of cards loses that round.\n\nWhen you play a <b>Boulder</b>,
    you have 3 tries to throw and hit your foe with it, while ghosts attempt to block
    your shots. If you do hit, your foe instantly loses the round.\n\nIf you play
    a <b>Pebble</b>, <i>you</i> instantly lose the round.\n\nBe the first to win
    3 rounds in total to become the Pebbler and win the game overall.\n "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
